# NewsCheck AI - Environment Configuration

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Security (Generate a secure key for production: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_production_secret_key_here

# News Search Provider Settings
# Options: 'newsapi' or automatic fallback (DuckDuckGo News)
NEWS_PROVIDER=newsapi

# Optional: Get your free API key at https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# SQLite Database Location (can also use SQLITE_PATH)
DATABASE_PATH=database/newscheck.db
